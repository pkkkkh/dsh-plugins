  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {

+# ========== Tool 3.5: 一次拿全（浓缩报告用） ==========
+
+@tool()
+async def bili_digest(bvid: str, comments: int = 5, lines: int = 40, full: bool = False) -> str:
+    """一次拿全「写报告」要用的料：基础数据 + 压缩字幕（带时间戳）+ 前几条热评。
+
+    入选的视频只调这一次，**别再分别调** bili_video_info / bili_subtitle / bili_comments。
+
+    Args:
+        bvid: 视频BV号
+        comments: 热评条数（0~10，默认 5）
+        lines: 字幕最多给几句（默认 40，按时间均匀抽样，避免全文灌进上下文）
+        full: true = 返回完整字幕（贵，只在需要逐句核对时用）
+    """
+    cred = get_cred()
+    v = video.Video(bvid=bvid, credential=cred)
+    info = await v.get_info()
+    stat = info.get("stat") or {}
+    cid = info.get("cid") or ((info.get("pages") or [{}])[0].get("cid") or 0)
+    out = {
+        "bvid": bvid,
+        "title": info.get("title", ""),
+        "up": (info.get("owner") or {}).get("name", ""),
+        "duration": info.get("duration", 0),
+        "stat": {k: stat.get(k, 0) for k in ("view", "like", "coin", "favorite", "reply", "danmaku")},
+        "subtitle": None,
+        "comments": [],
+    }
+
+    try:
+        sub_list = await v.get_subtitle(cid=cid)
+        subs = sub_list.get("subtitles") or []
+        target = None
+        for s in subs:
+            if s.get("lan") in ("ai-zh", "zh-CN", "zh"):
+                target = s
+                break
+        if target is None and subs:
+            target = subs[0]
+        if target:
+            url = target.get("subtitle_url", "")
+            if url.startswith("//"):
+                url = "https:" + url
+            import aiohttp
+            async with aiohttp.ClientSession() as ses:
+                async with ses.get(url) as resp:
+                    body = (await resp.json()).get("body") or []
+            segs = []
+            for x in body:
+                text = str(x.get("content", "")).strip()
+                if not text:
+                    continue
+                t = int(float(x.get("from", 0) or 0))
+                segs.append((t, text))
+            if full:
+                pick = segs
+            else:
+                n = max(5, min(120, int(lines or 40)))
+                if len(segs) <= n:
+                    pick = segs
+                else:
+                    step = (len(segs) - 1) / (n - 1)
+                    pick = [segs[round(i * step)] for i in range(n)]
+            out["subtitle"] = {
+                "language": target.get("lan_doc", ""),
+                "segments": len(segs),
+                "truncated": len(pick) < len(segs),
+                "lines": [{
+                    "t": "%02d:%02d" % (t // 60, t % 60),
+                    "s": text[:80],
+                } for t, text in pick],
+            }
+    except Exception as e:
+        out["subtitle"] = {"error": str(e)[:120]}
+
+    try:
+        n = max(0, min(10, int(comments or 0)))
+        if n:
+            raw = json.loads(await bili_comments(bvid, n))
+            items = raw.get("comments") or []
+            out["comments"] = [{
+                "user": c.get("user", ""),
+                "likes": c.get("like", 0),
+                "text": str(c.get("content", ""))[:80],
+            } for c in items[:n]]
+    except Exception as e:
+        out["comments_error"] = str(e)[:120]
+
+    return json.dumps(out, ensure_ascii=False)
+
 # ========== Tool 4: 获取弹幕 ==========
 
 @tool()
